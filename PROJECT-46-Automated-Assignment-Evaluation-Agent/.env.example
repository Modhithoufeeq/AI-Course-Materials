# ==============================================================================
# AUTOMATED ASSIGNMENT EVALUATION AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Automated Assignment Evaluation Agent"
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security & Authentication
# Generate a strong 64+ char random secret in production
SECRET_KEY=change-this-super-secret-jwt-key-min-32-chars-long-evaluation-agent
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Default local PostgreSQL URI, automatically falls back to SQLite if PostgreSQL is unreachable in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assignment_eval_db

# ChromaDB Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_MODE=local

# Document Storage Path
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_MB=25

# AI / LLM Configuration
# Options: gemini, openai, anthropic, mock_deterministic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Originality / Similarity Settings
SIMILARITY_THRESHOLD_LOW=0.20
SIMILARITY_THRESHOLD_MEDIUM=0.45
SIMILARITY_THRESHOLD_HIGH=0.70
