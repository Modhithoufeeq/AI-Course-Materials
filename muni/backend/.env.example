# ─────────────────────────────────────────────────────────────────────────────
# Backend environment — copy to backend/.env and adjust as needed.
# All values shown are the defaults; nothing is required.
# ─────────────────────────────────────────────────────────────────────────────

# App / API
APP_NAME=Document Search Platform
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080"]

# Ollama (free open-source models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=180.0
EMBEDDING_DIM=768          # nomic-embed-text → 768

# PostgreSQL / PGVector
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=ragdb
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres
PGVECTOR_TABLE=documents
PGVECTOR_METADATA_TABLE=document_meta

# Retrieval tuning
RETRIEVAL_TOP_K=6
COMPRESSION_ENABLED=true
COMPRESSION_CONTEXT_WINDOW=4   # passages kept after LLM-based re-ranking/compression
RAG_TEMPERATURE=0.1

# Agentic pipeline
AGENTIC_MODE=true               # false → plain LlamaIndex query engine
CREW_VERBOSE=false

# Arize Phoenix observability
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_UI_URL=http://localhost:6006

# Ingestion
INGEST_DIR=                  # defaults to <repo>/data/documents
AUTO_INGEST_ON_STARTUP=false
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1024
CHUNK_OVERLAP=200

# Tracing master switch ( Phoenix )
TRACING_ENABLED=true